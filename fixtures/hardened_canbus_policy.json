{
  "policy_name": "Hardened-Automotive-Powertrain-CAN",
  "vehicle_platform": "Logihertz-DriveCore-EV",
  "version": "1.0",
  "organization": "Logihertz Systems (OPC) Private Limited",
  "secoc_authentication_enabled": true,
  "secoc_mac_bits": 32,
  "uds_session_guard_in_motion": true,
  "allow_unauthenticated_uds_0x34": false,
  "socketcan_tcp_bridge_enabled": false,
  "bind_address": "127.0.0.1",
  "can_raw_filter_allowlist_enabled": true,
  "unknown_arbitration_id_policy": "DROP",
  "max_bus_load_percent": 70.0,
  "dominant_id_flood_protection": true,
  "inter_arrival_anomaly_detection": true,
  "min_interval_tolerance_ratio": 0.35,
  "uds_seed_entropy_bits": 128,
  "uds_security_access_lockout_seconds": 15,
  "gateway_domain_isolation": true,
  "obd2_direct_bus_access": false,
  "bus_off_exponential_recovery": true,
  "monitor_error_frames": true,
  "strict_dlc_validation": true,
  "dbc_signal_bounds_check": true
}
