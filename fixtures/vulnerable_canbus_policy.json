{
  "policy_name": "Insecure-Legacy-CAN-Policy",
  "vehicle_platform": "Untrusted-Legacy-Bus",
  "version": "0.1",
  "organization": "Untrusted External Entity",
  "secoc_authentication_enabled": false,
  "secoc_mac_bits": 16,
  "uds_session_guard_in_motion": false,
  "allow_unauthenticated_uds_0x34": true,
  "socketcan_tcp_bridge_enabled": true,
  "bind_address": "0.0.0.0",
  "can_raw_filter_allowlist_enabled": false,
  "unknown_arbitration_id_policy": "ACCEPT",
  "max_bus_load_percent": 95.0,
  "dominant_id_flood_protection": false,
  "inter_arrival_anomaly_detection": false,
  "min_interval_tolerance_ratio": 0.1,
  "uds_seed_entropy_bits": 32,
  "uds_security_access_lockout_seconds": 0,
  "gateway_domain_isolation": false,
  "obd2_direct_bus_access": true,
  "bus_off_exponential_recovery": false,
  "monitor_error_frames": false,
  "strict_dlc_validation": false,
  "dbc_signal_bounds_check": false
}
